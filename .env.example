# =============================================================================
# Kie.ai API Key - wymagany
# =============================================================================
# Klucz znajdziesz na https://kie.ai po zalogowaniu (zakladka API Keys)

KIE_API_KEY=tutaj_wklej_swoj_klucz_z_kie_ai

# =============================================================================
# S3 / MinIO - wymagane (uploady zdjec referencyjnych do Kie.ai)
# =============================================================================
# Kie.ai API wymaga aby zdjecia referencyjne byly publicznie dostepne pod URL.
# Skrypt uploaduje je na Twoj S3/MinIO i przekazuje URL do API.

# Endpoint S3 - dla MinIO np. https://minio.twojadomena.com
# dla AWS S3 np. https://s3.eu-central-1.amazonaws.com
S3_ENDPOINT_URL=https://minio.twojadomena.com

S3_ACCESS_KEY=twoj_access_key
S3_SECRET_KEY=twoj_secret_key
S3_BUCKET=nazwa_bucketu
S3_REGION=us-east-1

# OPCJONALNE - publiczny URL inny niz endpoint (np. CDN przed MinIO)
# Jesli pominete, uzywany jest S3_ENDPOINT_URL
# S3_PUBLIC_URL=https://cdn.twojadomena.com
